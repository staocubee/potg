// PropertyOnTheGo — core data model (Priority 1 & 2 of the blueprint's
// Engineering Implementation Priorities: multi-account foundation, property
// portfolio, document vault, and the AI layer's request/output/approval log).
//
// This intentionally covers Modules 1-4 and the AI entities from Section 14
// of the blueprint, not the full 24-module schema — later modules (projects,
// vendors, payments/escrow, inspections, leases, etc.) extend this same
// account/property/permission spine when they're built.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- Module 1: User, Tenant, and Account Management -------------------

enum AccountType {
  INDIVIDUAL
  FAMILY
  COMPANY
  VENDOR
  SUPPLIER
  // A renter's own account — distinct from the landlord's INDIVIDUAL/
  // FAMILY/COMPANY account the same way VENDOR/SUPPLIER are their own
  // marketplace-side identity. See Lease.tenantAccountId for how one
  // gets linked to the lease it belongs to.
  TENANT
}

enum SubscriptionPlan {
  INDIVIDUAL
  FAMILY
  COMPANY
  VENDOR
  SUPPLIER
  ENTERPRISE
}

model Account {
  id               String           @id @default(uuid())
  accountType      AccountType
  name             String
  country          String
  currency         String
  timezone         String
  status           String           @default("active")
  subscriptionPlan SubscriptionPlan @default(INDIVIDUAL)
  // The scheduled half of Module 14's Reports — off by default, an
  // account opts in. ReportsSchedulerService's daily @Cron reads this
  // plus reportDigestLastSentAt to decide who's due; ReportsService.
  // sendDigest (the same method a manual "send me one now" call uses)
  // is what actually builds and emails one.
  reportDigestFrequency  String    @default("off") // off | weekly | monthly
  reportDigestLastSentAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  members    AccountMember[]
  properties Property[]
  documents  Document[]
  aiRequests AiRequest[]
  vendor     Vendor?
  projects   Project[]
  payments   Payment[]
  receipts   Receipt[]
  listings        PropertyListing[]
  supplier        Supplier?
  orders          Order[]
  aiConversations AiConversation[]
  invites         AccountInvite[]
  rentalBookings  RentalBooking[]
  cartItems       CartItem[]
  // The other end of Lease.tenantAccountId — a TENANT-type account's own
  // linked lease(s). Named explicitly since Account already reaches
  // Lease indirectly through Property, and this is a second, direct path.
  tenantLeases    Lease[]          @relation("TenantAccountLeases")
  reportDefinitions ReportDefinition[]
  adminActions    PlatformAdminAction[]
  announcements   PropertyAnnouncement[]
  communities     Community[]
  notifications   Notification[]
  developmentAgreementsProposed PropertyDevelopmentAgreement[]
  packageSubscriptions PackageSubscription[]
  branches Branch[]

  @@map("accounts")
}

// The report-builder half of "the rest of the Reports module" — a saved
// selection of metrics from ReportsService's own fixed metric registry
// (itself a projection of the one getPortfolioOverview computation, not a
// dynamic query engine — see ReportsService.METRIC_REGISTRY's comment).
// `metrics` is a plain string array of registry keys, not a query
// language — there's nothing to parse or validate beyond "is this key in
// the registry," which ReportsService checks at create/run time, not here.
model ReportDefinition {
  id        String   @id @default(uuid())
  accountId String
  name      String
  metrics   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("report_definitions")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  // Nullable — real Google Sign-In (this pass): a user who only ever
  // signs in via Google has no password of their own to hash.
  // AuthService.login refuses a password attempt against a null hash with
  // a clear "use Google, or set one via Forgot password" message rather
  // than crashing bcrypt.compare on a null second argument — and Forgot
  // password genuinely works here unchanged, since resetPassword() always
  // just overwrites this column regardless of its prior value, letting a
  // Google-only user pick up a real password later if they want a second
  // way in.
  passwordHash String?
  // Google's own stable per-account subject id ("sub" in the verified ID
  // token) — the primary lookup key for a returning Google sign-in
  // (AuthService.googleAuth checks this before falling back to email).
  // Null for every account that has never used Google. A verified Google
  // email matching an *existing* password-only account's email links
  // this in-place rather than creating a second User row for the same
  // person — safe because Google only ever reports `email_verified: true`
  // for an address it has itself confirmed the account holder controls.
  googleId     String?  @unique
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Real email verification (this pass) — null means unverified, the
  // state a brand-new password registration starts in. Not the same
  // thing as identityVerificationStatus below (a person's real-world
  // identity, via Sumsub) — this is only "does this account control the
  // inbox it registered with." See EmailVerificationToken's own schema
  // comment for exactly what sets this and when.
  emailVerifiedAt DateTime?

  // Module 6's real neutral-reviewer gap that isn't about a business
  // (Vendor/Supplier.verificationStatus) or a document
  // (Document.verificationStatus) — this is the actual person behind an
  // account. Unlike those two, deliberately not a human platform_reviewer
  // decision: Sumsub's own document+selfie review either approves or
  // rejects this user, so IdentityService.refreshStatus sets this
  // directly from Sumsub's result, no pending-for-a-human step on this
  // scaffold's own side (Sumsub's reviewers are the "human," just not
  // one of this platform's own roles). Document/selfie images themselves
  // never touch this backend at all — the WebSDK on the frontend talks
  // to Sumsub directly with a short-lived access token, so there's
  // nothing here for this codebase to store or leak. sumsubApplicantId
  // is the one thing worth persisting: it's what a later status check
  // polls against, since Sumsub's review happens on their own side, not
  // synchronously in the request that started it (unlike a single NIN
  // lookup, which used to return a definitive answer immediately).
  identityVerificationStatus String    @default("not_verified") // not_verified | pending | verified | failed
  identityVerificationNotes  String?
  identityVerifiedAt         DateTime?
  sumsubApplicantId          String?

  memberships             AccountMember[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  refreshTokens           RefreshToken[]
  sentInvites             AccountInvite[]

  @@map("users")
}

// Auth hardening pass: backs POST /auth/forgot-password + /auth/reset-password.
// tokenHash stores sha256(rawToken), never the raw token itself — the same
// "don't store the secret in a form a DB leak could use directly" reasoning
// passwordHash already follows, just with a fast hash since this token is
// already high-entropy random bytes rather than a user-chosen password (no
// need for bcrypt's deliberate slowness here). One-time use via usedAt.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Real email verification (this pass) — same tokenHash/expiresAt/usedAt
// shape as PasswordResetToken above, for the same reasons. Backs
// POST /auth/verify-email + /auth/resend-verification.
// User.emailVerifiedAt is what actually gates the "verify your email"
// banner (null = unverified) — set directly, with no token flow at all,
// for a brand-new Google Sign-In user (Google already proved the
// address) and for an existing password account the moment it links a
// Google identity with the same verified email; earned the ordinary way
// (clicking the emailed link) for every plain password registration.
// AuthService.resetPassword also sets it on a successful reset — actually
// clicking a link mailed to that address is the same real proof of inbox
// control this flow is otherwise built around.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// One row per issued refresh token, keyed by the `jti` claim embedded in
// that token's JWT — the JWT signature is still what proves possession,
// this row is only what makes early revocation possible (logout, password
// reset) instead of every refresh token being valid until its own 30-day
// expiry no matter what. AuthService.refresh() rotates: it revokes the
// token being redeemed and inserts a fresh row for the one it issues, so a
// stolen-and-replayed old refresh token is rejected even if it hasn't
// expired yet.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  jti       String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Roles are account-scoped assignments; permissions are a fixed, seedable
// vocabulary (see prisma/seed.ts) matching Section 8's "Permission Areas".
model Role {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. "property_owner", "family_admin", "vendor"
  name        String
  description String?

  permissions RolePermission[]
  members     AccountMember[]
  invites     AccountInvite[]

  @@map("roles")
}

model Permission {
  id    String @id @default(uuid())
  key   String @unique // e.g. "property:read", "payment:approve", "ai:act"
  label String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// The "Payment/escrow licensing, market-specific verification mechanisms,
// and data residency" gap the blueprint review flagged as compliance
// work that has to run alongside engineering — this is NOT that work
// itself (no code grants a real license, verifies a real jurisdiction's
// requirements, or enforces real data residency); it's a checklist the
// platform's own trust & safety function uses to track that the work
// exists and where it stands. Genuinely platform-wide, like Role/
// Permission above (the only other account-independent tables in this
// schema) — no accountId, because this tracks the platform operator's
// own regulatory posture, not any one tenant's. Gated on compliance:
// read/write, granted only to platform_reviewer (see seed.ts) — same
// "the role that owns this data never gets it" isolation every other
// platform-reviewer-only permission already uses.
model ComplianceItem {
  id           String   @id @default(uuid())
  jurisdiction String // e.g. "Nigeria", "European Union" — free text, not an enum: this scaffold can't know every market the platform might expand into
  category     String // e.g. "payment_licensing", "kyc_verification", "data_residency" — free text for the same reason
  title        String
  status       String   @default("not_started") // not_started | in_progress | done
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("compliance_items")
}

// Module 16-24's "admin operations" bucket, scoped to its one genuinely
// buildable slice: nothing anywhere on this platform could see every
// account that exists (Role/Permission and ComplianceItem above are the
// only other account-independent tables, and neither is a directory of
// tenants), or act on one platform-wide the way platform_reviewer already
// acts on any vendor/supplier/dispute/document/review. Every row here is
// one platform_admin action against one account — not a generic activity
// log, just the two actions PlatformAdminService actually exposes
// (suspend/reinstate) — kept forever, never edited or deleted, same
// "an audit with no reasoning recorded isn't an audit" reasoning
// VendorTrustAudit.notes already establishes. performedByUserId is a
// plain string with no relation, same as VendorTrustAudit.
// reviewedByUserId — this is a record of who did it, not a live
// reference anything needs to join through.
model PlatformAdminAction {
  id              String   @id @default(uuid())
  targetAccountId String
  action          String // suspend | reinstate
  reason          String
  performedByUserId String
  createdAt       DateTime @default(now())

  targetAccount Account @relation(fields: [targetAccountId], references: [id], onDelete: Cascade)

  @@map("platform_admin_actions")
}

// A user may belong to several accounts at once (personal, family, company,
// vendor) — this is the multi-tenancy join the blueprint calls out as
// something to get right on day one.
model AccountMember {
  id        String   @id @default(uuid())
  accountId String
  userId    String
  roleId    String
  status    String   @default("active")
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  propertyGrants PropertyAccessGrant[]
  aiRequests     AiRequest[]

  @@unique([accountId, userId])
  @@map("account_members")
}

// Closes the gap AddMemberDto's own comment used to flag: POST
// /accounts/:accountId/members only ever worked for an email that already
// had a User. Same tokenHash pattern as PasswordResetToken — the raw
// token is a one-time bearer credential, only its hash is ever stored.
// AccountsService.addMember creates one of these instead of failing when
// the email has no User yet; GET /invites/:token lets the recipient see
// what they're being invited into before deciding whether to log in
// (AccountsService.acceptInvite) or register (AuthService.register's
// optional inviteToken, which does the same thing in the same call that
// creates their User).
model AccountInvite {
  id              String    @id @default(uuid())
  accountId       String
  email           String
  roleId          String
  tokenHash       String    @unique
  invitedByUserId String
  status          String    @default("pending") // pending | accepted | revoked
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id])
  invitedBy User    @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@map("account_invites")
}

model KycVerification {
  id          String    @id @default(uuid())
  userId      String
  status      String    @default("not_verified") // not_verified | submitted | verified | rejected
  provider    String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  notes       String?

  @@map("kyc_verifications")
}

// --- Module 2: Property Portfolio Management ---------------------------

model Property {
  id             String    @id @default(uuid())
  accountId      String
  // Optional — see Branch's own schema comment. Null means "not assigned
  // to a branch," a real, expected state every branch-scoped report
  // reports as its own "Unassigned" bucket rather than silently dropping.
  branchId       String?
  propertyType   String
  name           String
  addressLine    String
  city           String?
  state          String?
  country        String
  latitude       Float?
  longitude      Float?
  status         String    @default("active")
  currentUse     String?
  estimatedValue Decimal?  @db.Decimal(14, 2)
  // Module 3: Property Details — physical specifications, amenities, and
  // a photo gallery for the property itself, distinct from Module 2's own
  // identity/location/value fields above and Module 4's paperwork
  // (Document). Filled a real, self-evident gap: the semantic-search
  // embedding text below (embeddingText, properties.service.ts) already
  // gave "3 bedroom flat in Lekki under renovation" as its own example
  // query, with no `bedrooms` field anywhere to ever back that up. All
  // optional — a property is real and useful in this scaffold long before
  // its owner has gotten around to filling in square footage. photoUrls
  // is the property's own general gallery, distinct from
  // PropertyListing.photoUrls (a listing's own marketing photos, possibly
  // a curated subset) and RenovationVisualization's before/after pair —
  // same "URL you provide yourself" convention every other *Url field in
  // this schema already uses, since no upload pipeline changed for this.
  bedrooms      Int?
  bathrooms     Int?
  squareFootage Float?
  yearBuilt     Int?
  amenities     String[] @default([])
  photoUrls     String[] @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account        Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  branch         Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  owners         PropertyOwner[]
  documents      Document[]
  accessGrants   PropertyAccessGrant[]
  timelineEvents PropertyTimelineEvent[]
  projects       Project[]
  listings       PropertyListing[]
  valuations     PropertyValuation[]
  inspections    PropertyInspection[]
  leases         Lease[]
  maintenanceRequests MaintenanceRequest[]
  visualizations RenovationVisualization[]
  embedding      PropertyEmbedding?
  announcements  PropertyAnnouncement[]
  devices        PropertyDevice[]
  tourAssets     PropertyTourAsset[]
  developmentAgreements PropertyDevelopmentAgreement[]

  @@map("properties")
}

// The vector half of "Search and vector infrastructure" (the other half
// is pg_trgm fuzzy search on the three marketplaces — see the migration
// enabling that). `embedding` is `vector(1536)` (OpenAI text-embedding-3-
// small's own dimension) — Prisma has no native vector type, so it's
// `Unsupported` here: every read/write of this column goes through raw
// SQL ($queryRaw/$executeRaw) in OpenAiEmbeddingService/PropertiesService,
// never the Prisma Client query builder. `accountId` is denormalized from
// Property.accountId purely so semantic search can filter by account
// directly in the raw SQL without a join — same tenant-isolation
// boundary property:read already enforces everywhere else.
model PropertyEmbedding {
  propertyId String                  @id
  accountId  String
  embedding  Unsupported("vector(1536)")
  updatedAt  DateTime

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_embeddings")
}

// --- Module 3: Ownership and Governance ---------------------------------

model PropertyOwner {
  id                  String    @id @default(uuid())
  propertyId          String
  ownerType           String // "account" | "user" — who actually holds this share
  ownerAccountId      String?
  ownerUserId         String?
  ownershipPercentage Decimal   @default(100) @db.Decimal(5, 2)
  startDate           DateTime  @default(now())
  endDate             DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_owners")
}

// Property-level ABAC on top of role-level RBAC (Section 8's example: "a
// family member can view documents but not approve payments").
model PropertyAccessGrant {
  id                 String   @id @default(uuid())
  propertyId         String
  accountMemberId    String
  canView            Boolean  @default(true)
  canEdit            Boolean  @default(false)
  canApprovePayments Boolean  @default(false)
  createdAt          DateTime @default(now())

  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  accountMember AccountMember @relation(fields: [accountMemberId], references: [id], onDelete: Cascade)

  @@unique([propertyId, accountMemberId])
  @@map("property_access_grants")
}

model PropertyTimelineEvent {
  id         String   @id @default(uuid())
  propertyId String
  eventType  String // purchased | document_uploaded | renovation_started | inspection_completed ...
  label      String
  occurredAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_timeline_events")
}

// --- Module 4: Document Vault and Legal Workflow ------------------------

model Document {
  id                 String    @id @default(uuid())
  accountId          String
  propertyId         String?
  // Optional — tags a document as belonging to a specific tenancy (a
  // signed tenancy agreement, a move-in inspection report, ...) rather
  // than the property generally. Same "optional cross-reference must
  // actually belong to this property" cross-check
  // ReportMaintenanceRequestDto.leaseId already gets. This is what lets
  // TenantService.findMyDocuments show a tenant only documents about
  // their own tenancy, not the landlord's full document vault.
  leaseId            String?
  documentType       String
  fileUrl            String
  verificationStatus String    @default("not_verified") // not_verified | submitted | verified | rejected
  verificationNotes  String? // reviewer's note — the reason for a rejection, or any caveat on a verification
  expiryDate         DateTime?
  uploadedByUserId   String
  createdAt          DateTime  @default(now())

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  lease    Lease?    @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  evidence DocumentEvidence[]

  @@map("documents")
}

// The structured "submit more evidence" channel document verification's
// "submitted" status was missing — same shape as DisputeEvidence (see
// its own comment): before this, "submitted" was a status with nothing
// behind it, no way for the account to actually attach a note/file back
// in response to a reviewer's request.
model DocumentEvidence {
  id                String   @id @default(uuid())
  documentId        String
  accountId         String // the document owner's own account — always one party here, unlike a dispute's two
  submittedByUserId String
  note              String
  fileUrl           String?
  createdAt         DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_evidence")
}

// --- Section 5 / 14: the AI Copilot Layer -------------------------------
//
// Every "Ask AI" panel interaction produces one AiRequest, at most one
// AiOutput (the draft), and — only if a human accepts it — one
// AiActionApproval. This is what makes the human-in-the-loop rule in
// Section 5.4 enforceable rather than just documented: nothing downstream
// should treat an AiOutput as final until an AiActionApproval exists for it.

model AiRequest {
  id              String   @id @default(uuid())
  accountId       String
  accountMemberId String
  moduleContext   String // e.g. "property:<uuid>", "project:<uuid>" — what the request was scoped to
  actionType      String // e.g. "verify_property_documents", "summarize_property"
  input           Json
  createdAt       DateTime @default(now())

  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountMember AccountMember @relation(fields: [accountMemberId], references: [id], onDelete: Cascade)
  output        AiOutput?

  @@map("ai_requests")
}

model AiOutput {
  id          String   @id @default(uuid())
  aiRequestId String   @unique
  draftLabel  String
  draftBody   Json
  createdAt   DateTime @default(now())

  aiRequest AiRequest         @relation(fields: [aiRequestId], references: [id], onDelete: Cascade)
  approval  AiActionApproval?

  @@map("ai_outputs")
}

model AiActionApproval {
  id              String   @id @default(uuid())
  aiOutputId      String   @unique
  decidedByUserId String
  decision        String // accepted | edited | discarded
  decidedAt       DateTime @default(now())
  notes           String?

  aiOutput AiOutput @relation(fields: [aiOutputId], references: [id], onDelete: Cascade)

  @@map("ai_action_approvals")
}

// --- Modules 7 & 9: Vendor Marketplace & Project Tracking ---------------
//
// Priority 3 of the Engineering Implementation Priorities. A Vendor is a
// 1:1 extension of a VENDOR-type Account (the account is what auth/RBAC
// already understands; the vendor row is the marketplace-facing profile on
// top of it). A Project always belongs to the property owner's account and
// property, and is what the wireframe's Scope -> Quote -> Materials ->
// Work -> Handover flow tracks stage-by-stage.

model Vendor {
  id                String   @id @default(uuid())
  accountId         String   @unique
  businessName      String
  serviceCategory   String // e.g. "renovation", "plumbing", "electrical", "landscaping"
  locationCoverage  String? // freeform area/region description
  verificationStatus String  @default("not_verified") // not_verified | pending | verified
  verificationNotes String? // the neutral reviewer's note — what's needed to move off "pending", or why a decision was made
  ratingAverage     Decimal? @db.Decimal(3, 2)
  // Self-reported by the vendor (PATCH /vendors/me/license) — a
  // professional license for categories where one is real (electrical,
  // security installation, general contracting, an inspector picked for
  // PropertyInspection.inspectorVendorId, ...), same "record what's true,
  // no forced workflow" tradeoff Lease.tenantName/MaintenanceRequest.
  // assignedTo already document, not a gated credential a reviewer
  // issues. Deliberately never a *positive* trust-score input for that
  // reason — see computeVendorTrustScore's own comment — only an expired
  // one counts against it. All three are set together or not at all,
  // same shape Vendor's bank-detail fields already use.
  licenseNumber      String?
  licenseIssuingBody String?
  licenseExpiresAt   DateTime?
  // A real payout (see PaymentsService.releaseMilestone) needs somewhere
  // to pay into. Paystack and Flutterwave both pay a local bank account —
  // bankAccountNumber/bankCode/bankAccountName are shared between the two
  // (all three set together or not at all, same "record what's true"
  // simplicity CreateLeaseDto's tenant fields already use), disambiguated
  // by which gateway payoutProvider says they belong to, since the two
  // gateways' own bank code lists are NOT interchangeable for the same
  // physical bank. PayPal pays an email address instead, hence the
  // separate paypalPayoutEmail field. paystackRecipientCode caches the
  // Transfer Recipient Paystack returns the first time a payout is
  // attempted (Flutterwave's own Transfer API needs no equivalent —
  // it takes the bank account directly on every transfer, no separate
  // recipient object).
  bankAccountNumber    String?
  bankCode             String?
  bankAccountName      String?
  paystackRecipientCode String?
  // Which real gateway (if any) the fields above are currently set up
  // for: "paystack" | "flutterwave" | "paypal" | null. Null (or no key
  // configured for whichever this says) falls back to a simulated payout
  // — same condition PaymentsService.releaseMilestone already checked via
  // bank-details-presence alone before a second bank-transfer-capable
  // gateway existed to disambiguate between.
  payoutProvider       String?
  paypalPayoutEmail    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account                Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  quotes                 VendorQuote[]
  assignments            ProjectVendorAssignment[]
  reviews                VendorReview[]
  payouts                Payout[]
  inspections            PropertyInspection[]
  maintenanceAssignments MaintenanceRequest[]
  trustAudits            VendorTrustAudit[]
  verificationEvidence   VendorVerificationEvidence[]

  @@map("vendors")
}

// The structured "submit more evidence" channel vendor verification was
// missing entirely — before this, "pending" was a status a
// platform_reviewer could set with no way for the vendor to respond
// through anything but general tools unrelated to verification itself.
// Same shape as DisputeEvidence/DocumentEvidence: one party only (the
// vendor's own account), not two.
model VendorVerificationEvidence {
  id                String   @id @default(uuid())
  vendorId          String
  submittedByUserId String
  note              String
  fileUrl           String?
  createdAt         DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_verification_evidence")
}

// The actual "neutral reviewer conducts a real audit" step Module 6 was
// missing — distinct from Vendor.verificationStatus (a gate: can this
// vendor operate at all, set-and-overwritten) and from VendorReview (a
// customer's own experience, not a neutral assessment). A
// platform_reviewer files one of these after actually looking into a
// vendor; computeVendorTrustScore (vendors/trust-score.ts) reads the
// most recent one as a real input, not just recomputed platform activity
// data. Every audit is kept, not overwritten — same "record what
// actually happened, let the history stand" reasoning
// AiActionApproval/Dispute/Document decisions already follow — so a
// vendor's full audit trail stays visible even though only the latest
// one feeds the live score.
model VendorTrustAudit {
  id               String   @id @default(uuid())
  vendorId         String
  reviewedByUserId String
  rating           String // clean | minor_concerns | major_concerns
  notes            String // required — an audit with no reasoning recorded isn't an audit
  createdAt        DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_trust_audits")
}

model Project {
  id                String    @id @default(uuid())
  accountId         String
  propertyId        String
  projectType       String // e.g. "renovation", "new_build", "maintenance"
  title             String
  scopeDescription  String?
  budget            Decimal?  @db.Decimal(14, 2)
  currency          String    @default("USD")
  status            String    @default("planning") // planning | in_progress | on_hold | completed | cancelled
  startDate         DateTime?
  expectedEndDate   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account       Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property      Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stages        ProjectStage[]
  milestones    ProjectMilestone[]
  updates       ProjectUpdate[]
  quotes        VendorQuote[]
  assignments   ProjectVendorAssignment[]
  reviews       VendorReview[]
  escrowAccount EscrowAccount?
  payments      Payment[]
  payouts       Payout[]
  disputes      Dispute[]
  orders        Order[]
  inspections   PropertyInspection[]
  visualizations RenovationVisualization[]

  @@map("projects")
}

// Seeded by default on project creation, matching the wireframe exactly:
// Scope -> Quote -> Materials -> Work -> Handover.
model ProjectStage {
  id        String   @id @default(uuid())
  projectId String
  name      String
  sortOrder Int
  status    String   @default("not_started") // not_started | in_progress | completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sortOrder])
  @@map("project_stages")
}

model ProjectMilestone {
  id              String    @id @default(uuid())
  projectId       String
  title           String
  description     String?
  paymentAmount   Decimal?  @db.Decimal(14, 2)
  dueDate         DateTime?
  status          String    @default("pending") // pending | in_progress | completed
  approvalStatus  String    @default("not_requested") // not_requested | requested | approved | rejected
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updates ProjectUpdate[]
  payouts Payout[]

  @@map("project_milestones")
}

model ProjectUpdate {
  id               String   @id @default(uuid())
  projectId        String
  milestoneId      String?
  submittedByUserId String
  description      String
  mediaUrls        String[] @default([])
  createdAt        DateTime @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@map("project_updates")
}

model VendorQuote {
  id        String   @id @default(uuid())
  projectId String
  vendorId  String
  amount    Decimal  @db.Decimal(14, 2)
  currency  String   @default("USD")
  notes     String?
  status    String   @default("submitted") // requested | submitted | accepted | declined | withdrawn
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_quotes")
}

model ProjectVendorAssignment {
  id        String   @id @default(uuid())
  projectId String
  vendorId  String
  role      String   @default("primary_contractor")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([projectId, vendorId])
  @@map("project_vendor_assignments")
}

// Gated on the project being marked "completed" (ProjectsService.complete)
// and the vendor actually having a ProjectVendorAssignment on it
// (VendorsService.createReview) — one review per vendor per project, same
// shape SupplierReview uses for orders below.
model VendorReview {
  id               String    @id @default(uuid())
  vendorId         String
  projectId        String
  accountId        String // who left the review, for tenant-isolation checks
  rating           Int // 1-5
  comment          String?
  response         String? // the reviewed vendor's own reply, if any
  respondedAt      DateTime?
  moderationStatus String    @default("published") // published | flagged | hidden
  flagReason       String? // why the reviewed vendor flagged this, if it has been
  flaggedAt        DateTime?
  moderationNotes  String? // the neutral reviewer's note when acting on a flag
  moderatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, vendorId])
  @@map("vendor_reviews")
}

// --- Module 11: Payments and Escrow --------------------------------------
//
// Priority 4. No real payment gateway is wired up here (Section 16 lists
// Paystack/Flutterwave/Stripe/PayPal as day-one integrations — this
// scaffold simulates a completed payment/payout instantly instead, the
// same way the AI layer's StubLlmProvider simulates a model). What's real
// is the ledger: every escrow balance change is an EscrowLedgerEntry, so
// the balance is always derivable from its history, not just a mutable
// number — that auditability is the actual point of this module, not the
// payment-provider integration.

model EscrowAccount {
  id        String   @id @default(uuid())
  projectId String   @unique
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String
  status    String   @default("active") // active | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments      Payment[]
  ledgerEntries EscrowLedgerEntry[]

  @@map("escrow_accounts")
}

// A deposit from the project owner into the project's escrow account.
// "provider" and "providerReference" are where a real gateway integration
// would record its own transaction id — status is always "completed" here
// since nothing actually calls out to one yet.
model Payment {
  id                String   @id @default(uuid())
  accountId         String
  projectId         String
  escrowAccountId   String
  amount            Decimal  @db.Decimal(14, 2)
  currency          String
  provider          String   @default("manual") // manual | paystack | flutterwave | stripe | paypal
  providerReference String?
  status            String   @default("completed") // pending | completed | failed | refunded
  createdAt         DateTime @default(now())

  account       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  escrowAccount EscrowAccount       @relation(fields: [escrowAccountId], references: [id], onDelete: Cascade)
  ledgerEntries EscrowLedgerEntry[]
  receipt       Receipt?
  disputes      Dispute[]

  @@map("payments")
}

model EscrowLedgerEntry {
  id                 String   @id @default(uuid())
  escrowAccountId    String
  entryType          String // deposit | release | refund | adjustment
  amount             Decimal  @db.Decimal(14, 2)
  balanceAfter       Decimal  @db.Decimal(14, 2)
  relatedPaymentId   String?
  relatedMilestoneId String?
  relatedPayoutId    String?
  notes              String?
  createdAt          DateTime @default(now())

  escrowAccount EscrowAccount @relation(fields: [escrowAccountId], references: [id], onDelete: Cascade)
  payment       Payment?      @relation(fields: [relatedPaymentId], references: [id], onDelete: SetNull)
  payout        Payout?       @relation(fields: [relatedPayoutId], references: [id], onDelete: SetNull)

  @@map("escrow_ledger_entries")
}

// Money moving out of escrow to the vendor hired on a project — created
// only by "release a milestone" (ProjectsService... see PaymentsService),
// never directly, so a Payout always traces back to the milestone it paid
// for.
model Payout {
  id                String    @id @default(uuid())
  vendorId          String
  projectId         String
  milestoneId       String?
  // Net — what the vendor actually receives, after the platform fee
  // below. Historically (before the fee existed) this equalled
  // grossAmount exactly; every Payout created since carries the real
  // split. This is what's actually sent through whichever real gateway
  // this payout's own `provider` field names — never grossAmount.
  amount            Decimal   @db.Decimal(14, 2)
  // The milestone's own full paymentAmount — also what's debited from
  // escrow and what EscrowLedgerEntry's own "release" entry records, so
  // the owner's real project cost is unaffected by the fee below; only
  // the vendor's own take-home is. See src/payments/platform-fee.ts for
  // the model this implements (vendor absorbs a real, configurable
  // percentage cut) and why the fee comes off the vendor's side, not an
  // extra charge to the owner. Rows created before this field existed
  // are backfilled to grossAmount = amount, platformFeeAmount = 0 —
  // historically accurate, since no fee was ever taken from them.
  grossAmount       Decimal   @default(0) @db.Decimal(14, 2)
  platformFeeAmount Decimal   @default(0) @db.Decimal(14, 2)
  currency          String
  status            String    @default("pending") // pending | processing | paid | failed
  payoutMethod      String    @default("manual") // manual | bank_transfer | mobile_money
  // Mirrors Payment.provider — which gateway (if any) actually moved this
  // payout, independent of payoutMethod's "what kind of rail" question.
  // Added because payoutMethod alone couldn't tell PaymentsService.verifyPayout/
  // finalizePayoutOtp which gateway's API to call once a second
  // bank-transfer-capable gateway existed alongside Paystack — every
  // "bank_transfer" payout used to mean "call Paystack", unconditionally.
  provider          String    @default("manual") // manual | paystack | flutterwave | paypal
  // Set for any real-gateway payout — that gateway's own transfer/payout
  // reference, the same "provider"/"providerReference" pairing Payment
  // already uses for a real gateway's own transaction id.
  providerReference String?
  createdAt         DateTime  @default(now())
  paidAt            DateTime?

  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone     ProjectMilestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  ledgerEntries EscrowLedgerEntry[]
  receipt       Receipt?
  disputes      Dispute[]

  @@map("payouts")
}

// Exactly one of paymentId/payoutId is set — a receipt is always for one
// side of a transaction, issued to whichever account was the counterparty
// on it (the payer for a Payment, the vendor's account for a Payout).
model Receipt {
  id            String   @id @default(uuid())
  accountId     String
  receiptNumber String   @unique
  paymentId     String?  @unique
  payoutId      String?  @unique
  amount        Decimal  @db.Decimal(14, 2)
  currency      String
  issuedAt      DateTime @default(now())

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  payout  Payout?  @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

// Module 18 (Dispute Resolution and Mediation), Phase 1 — real,
// user-supplied scope. The engineering notes' own words: "Dispute cases
// should be tightly linked to payments, orders, projects, and
// contracts" — payments and projects were already covered by every
// mechanism below (raise, evidence, two-party resolution, arbitration,
// payment/milestone hold); orders were not linked at all. projectId is
// now optional and orderId joins it — exactly one of the two is set per
// dispute, enforced in PaymentsService (raiseDispute/raiseOrderDispute),
// not a DB constraint, same "the service enforces the business rule"
// shape this schema already uses elsewhere (e.g. Vendor's bank-detail
// trio). "Contracts" (Leases) and property-listing disputes are
// deliberately deferred to a later phase — see PaymentsService's own
// comment on raiseOrderDispute for the reasoning. disputeType is the
// blueprint's own "Dispute Types" list, defaulted to "other" so
// existing rows created before this pass still have a valid value.
model Dispute {
  id                String    @id @default(uuid())
  projectId         String?
  orderId           String?
  raisedByAccountId String
  milestoneId       String?
  paymentId         String?
  payoutId          String?
  disputeType       String    @default("other") // poor_workmanship | delayed_project | material_delivery_issue | payment_disagreement | property_listing_dispute | tenant_complaint | vendor_misconduct | refund_request | other
  reason            String
  status            String    @default("open") // open | under_review | resolved | rejected
  resolutionNotes   String?
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  project  Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order    Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment  Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payout   Payout?           @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  evidence DisputeEvidence[]

  @@map("disputes")
}

// The structured "submit more evidence" channel the arbitration
// evidence-request step (Dispute.status "under_review") was missing —
// before this, "more evidence" meant whatever general tool a party
// happened to reach for (a project update, a reply somewhere else
// entirely), nothing tied to the dispute itself or visible to the
// arbitrator in one place.
model DisputeEvidence {
  id                String   @id @default(uuid())
  disputeId         String
  accountId         String // which party submitted this — owner's or vendor's account
  submittedByUserId String
  note              String
  fileUrl           String? // optional supporting link — same "URL you provide yourself" shape as Document.fileUrl
  createdAt         DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@map("dispute_evidence")
}

// --- Modules 5 & 10: Property Marketplace & Materials Marketplace -------
//
// Priority 5. Two separate marketplaces sharing one pattern: a seller-side
// profile (a listing is created from an owned Property; a Supplier is a
// 1:1 profile on a SUPPLIER-type account, same shape as Vendor), a public
// browse/search surface with no tenant isolation by design, and a
// buyer-side action that's deliberately its own step, never automatic —
// submitting an offer, placing an order. Module 6's full verification
// workflow (a separate reviewer, risk flags, trust scores) is out of scope
// here; PropertyListing.verificationStatus is a plain field with no
// dedicated review endpoint yet, the same simplification Vendor took in
// Priority 3.

model PropertyListing {
  id                 String   @id @default(uuid())
  propertyId         String
  accountId          String
  listingType        String // sale | rent | short_let
  askingPrice        Decimal  @db.Decimal(14, 2)
  currency           String
  title              String
  description        String?
  photoUrls          String[] @default([])
  status             String   @default("draft") // draft | active | under_offer | sold | rented | withdrawn
  verificationStatus String   @default("not_verified") // not_verified | submitted | verified | rejected
  // The gap the workflow audit found: unlike Vendor/Supplier/Document,
  // this had no reviewer's-note field and — until ListingsService.
  // setVerificationStatus — no action anywhere that ever set
  // verificationStatus to anything but its own default. Same "what's
  // needed to move off submitted, or the reason for the final call"
  // shape those other three already use.
  verificationNotes  String?
  viewCount          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  property  Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inquiries ListingInquiry[]
  offers    ListingOffer[]
  favorites ListingFavorite[]
  sale      ListingSale?

  @@map("property_listings")
}

model ListingInquiry {
  id           String   @id @default(uuid())
  listingId    String
  accountId    String // the inquiring buyer's account — soft reference, same as VendorReview.accountId
  message      String
  contactEmail String?
  contactPhone String?
  status       String   @default("new") // new | responded | closed
  createdAt    DateTime @default(now())

  listing PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_inquiries")
}

model ListingOffer {
  id        String   @id @default(uuid())
  listingId String
  accountId String // the buyer's account — soft reference
  amount    Decimal  @db.Decimal(14, 2)
  currency  String
  message   String?
  status    String   @default("submitted") // submitted | countered | accepted | rejected | withdrawn
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sale    ListingSale?

  @@map("listing_offers")
}

// The real gap the workflow audit found: an accepted ListingOffer never
// led anywhere — nothing tracked a document checklist, a deposit, or
// completion, and nothing ever transferred the property into the
// buyer's own portfolio (ListingsService.respondToOffer only ever
// flipped the listing to "under_offer" and stopped there). Created the
// moment an offer is accepted (see respondToOffer's own comment).
// Deliberately NOT wired into Payment/EscrowAccount — both require a
// projectId, and a property purchase isn't a renovation project — same
// "record what's true, don't fake a payment rail that isn't there"
// restraint LeaseRentPayment's own comment already established for rent;
// a real deployment collecting a real deposit would tie this to a real
// gateway instead of a plain recorded timestamp. The document checklist
// itself isn't stored here at all — it's computed on read from the
// property's own real Document rows against DEFAULT_DOCUMENT_CHECKLIST
// (see ListingsService.getSale), so there's nothing to keep in sync.
model ListingSale {
  id                String    @id @default(uuid())
  listingId         String    @unique
  offerId           String    @unique
  buyerAccountId    String // soft reference, same as ListingOffer.accountId
  sellerAccountId   String // soft reference, same reason
  amount            Decimal   @db.Decimal(14, 2)
  currency          String
  depositRecordedAt DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  listing PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  offer   ListingOffer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("listing_sales")
}

model ListingFavorite {
  id        String   @id @default(uuid())
  listingId String
  accountId String
  createdAt DateTime @default(now())

  listing PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, accountId])
  @@map("listing_favorites")
}

model Supplier {
  id                  String   @id @default(uuid())
  accountId           String   @unique
  businessName        String
  category            String // materials | tools | equipment
  locationCoverage    String?
  verificationStatus  String   @default("not_verified") // not_verified | pending | verified
  verificationNotes   String? // the neutral reviewer's note — what's needed to move off "pending", or why a decision was made
  ratingAverage       Decimal? @db.Decimal(3, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]
  reviews  SupplierReview[]
  trustAudits SupplierTrustAudit[]
  verificationEvidence SupplierVerificationEvidence[]

  @@map("suppliers")
}

// The materials-marketplace counterpart to VendorVerificationEvidence —
// same shape, same reasoning.
model SupplierVerificationEvidence {
  id                String   @id @default(uuid())
  supplierId        String
  submittedByUserId String
  note              String
  fileUrl           String?
  createdAt         DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_verification_evidence")
}

// The materials-marketplace counterpart to VendorTrustAudit — same
// shape, same reasoning: a platform_reviewer's own real audit, kept as
// history, distinct from Supplier.verificationStatus and from
// SupplierReview (a buyer's own experience).
model SupplierTrustAudit {
  id               String   @id @default(uuid())
  supplierId       String
  reviewedByUserId String
  rating           String // clean | minor_concerns | major_concerns
  notes            String
  createdAt        DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_trust_audits")
}

model Product {
  id                String   @id @default(uuid())
  supplierId        String
  name              String
  category          String // e.g. "cement", "tiles", "electrical", "tools" — freeform, matched by the boq_to_order AI skill
  unit              String // e.g. "bag", "piece", "sqm", "roll"
  unitPrice         Decimal  @db.Decimal(14, 2)
  currency          String
  stockQuantity     Int      @default(0)
  description       String?
  status            String   @default("active") // active | out_of_stock | discontinued
  // Module 10's rental calendar — a product is either sold (the existing
  // Order path) or rentable by the day, never both at once in this
  // scaffold's model. isRentable false leaves rentalPricePerDay
  // meaningless, same "flag plus a field that's only meaningful when the
  // flag is set" shape EscrowAccount/Payment pairs already use elsewhere.
  isRentable        Boolean  @default(false)
  rentalPricePerDay Decimal? @db.Decimal(14, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  rentalBookings RentalBooking[]
  cartItems      CartItem[]

  @@map("products")
}

// Module 10's tool/equipment rental booking flow — a product's stock is
// shared between however many units are out on rental at once; availability
// is checked against confirmed/requested bookings whose date range overlaps
// the new request, not against a separate rental-only stock count.
model RentalBooking {
  id         String    @id @default(uuid())
  productId  String
  accountId  String // the renting account
  quantity   Int       @default(1)
  startDate  DateTime
  endDate    DateTime
  status     String    @default("requested") // requested | confirmed | returned | cancelled
  totalPrice Decimal   @db.Decimal(14, 2)
  currency   String
  notes      String?
  returnedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("rental_bookings")
}

// A real server-side cart, closing the "materials cart still isn't
// server-side" gap the localStorage-backed cart on the supplier detail
// page always documented as a limitation — this doesn't replace that
// page's localStorage cart (still used as the pre-account-decision
// scratch space while browsing), it's what CheckoutCart reads once the
// buyer is ready to place a real order. One row per (accountId,
// productId); quantity 0 is never stored, removeCartItem/quantity<=0
// deletes the row instead.
model CartItem {
  id        String   @id @default(uuid())
  accountId String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([accountId, productId])
  @@map("cart_items")
}

model Order {
  id              String   @id @default(uuid())
  accountId       String
  supplierId      String
  projectId       String?
  status          String   @default("pending") // pending | confirmed | shipped | delivered | cancelled
  totalAmount     Decimal  @db.Decimal(14, 2)
  currency        String
  deliveryAddress String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account  Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  supplier Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  project  Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  delivery Delivery?
  review   SupplierReview?
  disputes Dispute[]

  @@map("orders")
}

// The materials-marketplace counterpart to VendorReview — gated on the
// order actually being delivered rather than a project being "completed"
// (an order doesn't always belong to a project at all, see projectId
// above), with the same one-review-per-transaction shape (@@unique via
// Order.review's implicit @unique on orderId below).
model SupplierReview {
  id               String    @id @default(uuid())
  supplierId       String
  orderId          String    @unique
  accountId        String // who left the review, for tenant-isolation checks
  rating           Int // 1-5
  comment          String?
  response         String? // the reviewed supplier's own reply, if any
  respondedAt      DateTime?
  moderationStatus String    @default("published") // published | flagged | hidden
  flagReason       String? // why the reviewed supplier flagged this, if it has been
  flaggedAt        DateTime?
  moderationNotes  String? // the neutral reviewer's note when acting on a flag
  moderatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("supplier_reviews")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(14, 2)
  lineTotal Decimal @db.Decimal(14, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Delivery {
  id                    String    @id @default(uuid())
  orderId               String    @unique
  status                String    @default("pending") // pending | in_transit | delivered | failed
  trackingReference     String?
  estimatedDeliveryDate DateTime?
  deliveredAt           DateTime?
  // The buyer's own confirmation, separate from deliveredAt above (which
  // the supplier sets unilaterally) — the audit's own finding: "only the
  // supplier can set delivery status, including delivered — the buyer
  // has no confirm-receipt action of their own." Settable only once the
  // supplier has already marked it delivered (see
  // MaterialsService.confirmReceipt).
  confirmedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("deliveries")
}

// --- Priority 6: Deeper AI and Advanced Analytics ------------------------
//
// Two additions. First, real multi-turn chat (Section 5.4/5.1: "every
// feature should let the user chat", Section 16: "an LLM provider with
// tool-calling/function-calling support") — everything before this was a
// single quick-action button per skill; AiConversation/AiMessage back a
// genuine back-and-forth that can call those same skills as tools mid-
// conversation (see ChatService). Second, a slice of Module 15 (Property
// Valuation and Investment Analytics) — just PropertyValuation, enough for
// an appreciation history and a baseline for ROI modeling; the rest of
// Module 15's engineering notes (market_price_records, investment_metrics
// as their own tables) are out of scope here, computed on the fly instead.

model AiConversation {
  id              String   @id @default(uuid())
  accountId       String
  accountMemberId String
  moduleContext   String? // optional — chat can be scoped ("property:<id>") or general portfolio chat
  title           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account  Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String // user | assistant
  content        String
  toolName       String? // set when this assistant reply came from running a skill mid-chat
  aiOutputId     String? // the AiOutput that tool call produced, if any — lets a client jump straight to Accept/Edit/Discard
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model PropertyValuation {
  id             String   @id @default(uuid())
  propertyId     String
  estimatedValue Decimal  @db.Decimal(14, 2)
  currency       String
  source         String   @default("manual") // manual | ai_estimate
  notes          String?
  valuedAt       DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_valuations")
}

// --- Module 8: Inspections -----------------------------------------------
//
// A scheduled, then completed, physical check of a property's condition —
// distinct from Module 4's document verification (which checks paperwork,
// not the property itself). No separate "Inspector" account type exists in
// this scaffold (Modules 1-24 stop at the ones this codebase actually
// implements — see the README): `inspectorVendorId` optionally ties the
// inspector to a real Vendor account (any marketplace vendor, not just one
// with a project on this property — the same "pick from GET /vendors"
// reach VendorsService.createReview already allows), and `inspectorName`
// stays freeform text for a non-platform inspector or a licensed-inspector
// role a real deployment would add. Same accountId-free, :propertyId-ABAC
// shape as PropertyValuation above — PermissionsGuard already enforces
// tenant isolation on any route nested under /properties/:propertyId, so
// there's no separate ownership check to duplicate here.
model PropertyInspection {
  id                String    @id @default(uuid())
  propertyId        String
  projectId         String? // set when this inspection is tied to a renovation project (e.g. a post-work inspection)
  inspectionType    String // general | pre_purchase | move_in | move_out | safety | post_renovation
  status            String    @default("scheduled") // scheduled | completed | cancelled
  scheduledFor      DateTime
  inspectorVendorId String? // set instead of inspectorName when the inspector is a platform vendor
  inspectorName     String?
  overallResult     String? // pass | needs_attention | fail — set on completion
  summary           String?
  // Real remote-verification evidence (this pass) — general walkthrough/
  // overview shots for the inspection as a whole, set alongside
  // overallResult/summary on completion. Same "you host it, this just
  // stores the URL" convention ProjectUpdate.mediaUrls/PropertyListing.
  // photoUrls already use — populated for real via POST /uploads (Cloudflare
  // R2), not a pasted-URL text field, matching how vendors.me.tsx/
  // materials.me.tsx/documents already upload real files.
  photoUrls         String[]  @default([])
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  property        Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  project         Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  inspectorVendor Vendor?              @relation(fields: [inspectorVendorId], references: [id], onDelete: SetNull)
  findings        InspectionFinding[]

  @@map("property_inspections")
}

model InspectionFinding {
  id           String   @id @default(uuid())
  inspectionId String
  area         String // e.g. "Kitchen", "Roof", "Electrical wiring"
  description  String
  severity     String   @default("minor") // minor | moderate | major
  // Real photo evidence tied to this specific finding, not just the
  // inspection as a whole — this is the actual gap between "you can view
  // a property remotely" (PropertyTourAsset, RenovationVisualization) and
  // "you can verify a specific claim remotely": a "cracked tile in
  // bathroom" finding with no photo is unverifiable at a distance, one
  // with a photo isn't. Same String[] convention as PropertyInspection.
  // photoUrls above.
  photoUrls    String[] @default([])
  createdAt    DateTime @default(now())

  inspection PropertyInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("inspection_findings")
}

// --- Module 13: Leases ---------------------------------------------------
//
// The marketplace side (Module 5 — `PropertyListing` with `listingType:
// "rent"`/`"short_let"`, `ListingInquiry`, `ListingOffer`) gets a property
// rented out; nothing tracked what happens *after* that — the ongoing
// tenancy, its rent schedule, or the payments against it. This is that:
// deliberately not wired to Listing/Offer at all (a lease can just as well
// start from an owner recording an existing tenancy that predates this
// software), same "record what's true, don't force a specific prior
// workflow" reasoning `PropertyValuation.source: "manual"` already uses.
// `tenantName`/`tenantEmail`/`tenantPhone` stay freeform text — set once
// when the lease is created, same as always, since the landlord may well
// be recording an existing tenancy before the tenant ever touches this
// platform. `tenantAccountId` is the real link: PropertiesService.
// linkTenantAccount sets it once a real AccountType.TENANT account
// exists for `tenantEmail` (the tenant has to sign up first — this never
// creates an account on the tenant's behalf), same "optional, landlord-
// initiated link to a real account" shape `inspectorVendorId`/
// `assignedVendorId` already established for Inspector/Contractor.
model Lease {
  id              String    @id @default(uuid())
  propertyId      String
  tenantName      String
  tenantEmail     String?
  tenantPhone     String?
  tenantAccountId String?
  rentAmount      Decimal   @db.Decimal(14, 2)
  currency        String
  rentFrequency   String // weekly | monthly | annually
  depositAmount   Decimal?  @db.Decimal(14, 2)
  startDate       DateTime
  endDate         DateTime?
  status          String    @default("active") // active | ended | terminated
  notes           String?
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantAccount       Account?             @relation("TenantAccountLeases", fields: [tenantAccountId], references: [id], onDelete: SetNull)
  rentPayments        LeaseRentPayment[]
  maintenanceRequests MaintenanceRequest[]
  documents           Document[]

  @@map("leases")
}

// A plain record that rent was paid — same "simulated, not a real payment
// rail" depth as Module 11's own Payment model (see its comment): this
// logs that a payment happened, it doesn't move any money or touch escrow.
// A real deployment collecting rent through the platform would tie this to
// Payment/EscrowAccount instead of standing alone.
model LeaseRentPayment {
  id          String   @id @default(uuid())
  leaseId     String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  periodStart DateTime
  periodEnd   DateTime
  method      String   @default("manual") // manual | bank_transfer | mobile_money
  notes       String?
  paidAt      DateTime @default(now())

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@map("lease_rent_payments")
}

// --- Module 12: Maintenance ----------------------------------------------
//
// Distinct from a renovation Project (Module 9) even though
// `Project.projectType` already allows `"maintenance"` as a value: a
// Project's Scope -> Quote -> Materials -> Work -> Handover stages,
// vendor quotes, and escrow are real machinery for a real renovation, not
// something anyone wants to spin up for "the kitchen faucet is leaking."
// This is the lightweight ticket that machinery was never meant to cover
// — open a request, optionally note who's handling it, resolve or cancel
// it. No formal relation for who reported it (`reportedBy` stays freeform
// text — same reasoning `Lease.tenantName` gives). Who's fixing it can now
// be either: `assignedVendorId` when it's a platform vendor (same
// marketplace-wide reach `PropertyInspection.inspectorVendorId` gets), or
// `assignedTo` freeform text when it's the owner doing it themselves or
// someone off-platform — the two are set mutually exclusively by
// PropertiesService, never both at once.
model MaintenanceRequest {
  id               String    @id @default(uuid())
  propertyId       String
  leaseId          String? // set when reported against an active tenancy
  title            String
  description      String
  // The audit's own finding: no taxonomy existed at all, only priority.
  // A flat category list, same shape as priority above — not a
  // sub-category/licensing-requirement system, that's a market-specific
  // config problem this scaffold doesn't attempt.
  category         String    @default("general") // plumbing | electrical | hvac | appliance | structural | pest_control | landscaping | painting | roofing | cleaning | general | other
  priority         String    @default("normal") // low | normal | high | urgent
  status           String    @default("open") // open | in_progress | resolved | cancelled
  reportedBy       String?
  assignedVendorId String? // set instead of assignedTo when the assignee is a platform vendor
  assignedTo       String?
  resolutionNotes  String?
  // Module 24's "Maintenance report" (cost) — set alongside
  // resolutionNotes at resolution time, since that's the only point the
  // real cost is actually known; null for a request that's still open,
  // was cancelled, or was resolved before this pass existed. No separate
  // currency field, same convention Property.estimatedValue already
  // uses — implicitly the account's own single currency.
  cost             Decimal?  @db.Decimal(14, 2)
  // The audit's own finding: no photo/attachment field existed at all —
  // resolution recorded only free-text notes and a cost number. Two
  // separate arrays, not one, because they answer two different
  // questions: photoUrls is "what's actually wrong" (settable at report
  // time, same as an inspection's own overview photos), resolutionPhotoUrls
  // is "proof it was actually fixed" (settable only at resolve time) —
  // conflating them would lose which photo was taken when.
  photoUrls           String[]  @default([])
  resolutionPhotoUrls String[]  @default([])
  // The audit's own finding: unlike ProjectMilestone, nothing here ever
  // gated work starting on an explicit sign-off — start() just flipped
  // straight to in_progress. Three states, not ProjectMilestone's four:
  // no "requested" here, since nothing in this codebase ever actually
  // transitions a milestone to "requested" either (its own enum comment
  // names it, but only not_requested -> approved is ever exercised) —
  // no reason to add a state this pass wouldn't use.
  approvalStatus   String    @default("not_requested") // not_requested | approved | rejected
  approvalNotes    String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lease          Lease?   @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  assignedVendor Vendor?  @relation(fields: [assignedVendorId], references: [id], onDelete: SetNull)

  @@map("maintenance_requests")
}

// "Community management" — the second, and last, sub-piece the genuinely
// undefined Modules 3, 16-21, 24 bucket has real scope for (see "Admin
// operations" above for the first). No blueprint text names what this
// bucket contains beyond the bare label, but "community management" in
// every real property-management product means the same thing: a
// landlord communicating with the tenants of its own portfolio — an
// announcement/notice board, not a social feature. propertyId is
// deliberately nullable: null reaches every tenant currently linked to
// any of this account's properties (a portfolio-wide notice — "the
// tenant portal will be down this weekend"), set reaches only that one
// property's own tenant(s) (a building-specific notice — "the elevator
// is broken"). Read entirely through TenantService.findMyAnnouncements,
// the same "my own thing, never an id the caller supplies" shape every
// other tenant-facing route already uses.
model PropertyAnnouncement {
  id              String   @id @default(uuid())
  accountId       String
  propertyId      String?
  title           String
  body            String
  createdByUserId String
  createdAt       DateTime @default(now())

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_announcements")
}

// The 2D half of "AI-generated renovation visualizations" (Priority 6's
// Deeper AI list) — real AR/VR (Module 23: AR/VR Property Viewing — see
// its own section below) stays out of scope, see the README's own note
// on why. This is a bounded, achievable slice: an input photo the caller
// already hosts (beforeImageUrl, same "URL you provide yourself"
// convention Document.fileUrl already uses — no upload pipeline exists
// in this scaffold), a text prompt describing the renovation, and an
// AI-generated afterImageUrl. Not routed through the AiRequest/AiOutput/
// AiActionApproval pipeline every AiSkill uses — there's no "draft to
// accept/discard" here the way a generated description or status update
// has; the image itself is the delivered result, closer in shape to
// PropertyValuation than to an AI skill's draft text.
//
// `kind` was added for Module 23's own "Virtual staging" and "Before/
// after visualization" features — both are the exact same before/photo
// + prompt + after/photo pipeline as a renovation preview, just with a
// staging-oriented prompt instead of a renovation one, so this reuses
// the model and service wholesale rather than duplicating either.
model RenovationVisualization {
  id                String    @id @default(uuid())
  propertyId        String
  projectId         String?
  requestedByUserId String
  kind              String    @default("renovation") // renovation | staging
  prompt            String
  beforeImageUrl    String
  // Set once ImageGenerationProvider returns and StorageService has
  // persisted the result — an AI image API's own returned URL typically
  // expires in hours, so this is always this scaffold's own storage
  // (Cloudflare R2), never the provider's.
  afterImageUrl String?
  status        String    @default("pending") // pending | completed | failed
  errorMessage  String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("renovation_visualizations")
}

// --- Module 22: Smart Home, IoT, and Sustainability ---------------------
//
// Real, user-supplied scope, but its own engineering notes call it out as
// "a later-stage module" whose job now is architecture, not live device
// data: "design architecture should allow device integrations later
// through API connectors." Of its 9 named features, 7 need a real,
// currently-unwired third-party device/utility API to mean anything
// (smart meter, energy, water, camera, lock, and solar readings, plus
// device-triggered maintenance alerts) — faking readings for hardware
// nothing is connected to would be inventing data, not building a
// feature, the same reasoning that kept SMS/WhatsApp/push notifications
// unattempted in Module 19. This model is the literal "architecture for
// later" the notes ask for: a real registry a property owner can use to
// record *intent* to connect a device, honestly stuck at
// "not_connected" until a real adapter exists to flip it — not a fake
// live reading.
model PropertyDevice {
  id         String   @id @default(uuid())
  propertyId String
  deviceType String // smart_meter | water_meter | security_camera | smart_lock | solar_inverter
  name       String
  provider   String? // freeform — e.g. "Shelly", "SolarEdge" — no adapter wired up for any of them yet
  status     String   @default("not_connected") // not_connected is the only value this pass can ever honestly set
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_devices")
}

// --- Module 23: AR/VR Property Viewing -----------------------------------
//
// Real, user-supplied scope. Real AR (a live camera overlay) and real VR
// (a 3D walkable space) both need infrastructure this scaffold doesn't
// have and this pass doesn't add — see the README's note on why (native
// ARKit/ARCore or WebXR, a 3D content pipeline, photogrammetry/NeRF
// reconstruction from photos). What the module's own engineering notes
// ask for regardless of that gap is concrete and buildable without any
// of it: "store media metadata in a way that supports 360 content and
// virtual tour assets." This is that table — an ordered list of 360°
// photos (or videos) per property, each just a URL the caller already
// hosts (same "URL you provide yourself" convention this whole schema
// uses) plus a room label and position, real enough to back a genuine
// pannable 360° viewer and a "walk through this sequence of rooms" tour
// on the web, with no 3D engine or native app required.
model PropertyTourAsset {
  id         String   @id @default(uuid())
  propertyId String
  mediaUrl   String
  mediaType  String   @default("photo_360") // photo_360 | video_360
  label      String? // e.g. "Living room", "Kitchen"
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_tour_assets")
}

// --- Property Development Agreements -------------------------------------
//
// A user-requested feature (not from the numbered blueprint): let a
// property owner invite a developer to build on their property under a
// real deal, not just an assigned-vendor construction job. Same "invite
// someone who may not be registered yet" shape AccountInvite already
// uses (developerEmail + a hashed token + expiry — see AccountsService
// for the pattern this clones), since a developer worth inviting may not
// have a PropertyOnTheGo account at all yet.
//
// Two deal structures, matching what was actually asked for:
//   - temporary_ownership: the developer gets a real, time-boxed
//     fractional stake in the property itself. Accepting this kind
//     writes a real PropertyOwner row (ownershipPercentage + startDate/
//     endDate) — a model that has existed in this schema since Module 1
//     and, per the same "dead field" audit that closed
//     PropertyAccessGrant/Account.timezone/Account.status in earlier
//     passes, had zero code anywhere reading or writing it before this.
//   - proceeds_share: the developer gets an agreed percentage of the
//     property's eventual sale proceeds. This is recorded as a real,
//     binding term on the agreement — but not automatically paid out:
//     nothing anywhere in this schema fires when a PropertyListing
//     actually sells (no code ever transitions a listing to "sold"), and
//     there's no proceeds-split/escrow mechanism for a sale event to pay
//     into. Building that is a real, separate undertaking (a sale-closing
//     flow plus a payout engine for it), deliberately not attempted here
//     — see the README's own note on this model.
model PropertyDevelopmentAgreement {
  id                      String    @id @default(uuid())
  propertyId              String
  accountId               String // the property owner's own account
  proposedByUserId        String
  developerEmail          String
  developerAccountId      String? // set once accepted — the account that now holds the stake/claim
  agreementType           String // temporary_ownership | proceeds_share
  ownershipPercentage     Decimal?  @db.Decimal(5, 2) // temporary_ownership only
  termMonths              Int? // temporary_ownership only
  proceedsSharePercentage Decimal?  @db.Decimal(5, 2) // proceeds_share only
  terms                   String // the actual freeform agreement description — percentages alone don't capture a real deal
  tokenHash               String    @unique
  status                  String    @default("pending") // pending | accepted | declined | cancelled | expired
  expiresAt               DateTime
  respondedAt             DateTime?
  createdAt               DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("property_development_agreements")
}

// --- Module 17: Estate and Community Management -------------------------
//
// Real scope supplied for this pass (unlike the rest of the 16-24
// bucket, which had none): apartment buildings, estates, and gated
// communities — a genuinely different shape from a single owner's
// single-tenant Property/Lease above. An estate has many residents at
// once, run by whoever manages the estate (an account, same as every
// other top-level owned resource — could be the same account that also
// owns Property rows, or a dedicated estate-management company that
// owns none). Phase 1 of 10 named features: Communities, Residents, and
// Community Announcements — the three that everything else (dues,
// visitor access, facility booking, complaints, polls, reports) would
// need to exist first anyway. Deliberately not linked to Property/Lease:
// a Resident here is a simpler record (name, unit, contact) than a full
// Property, matching how Lease.tenantName started as freeform text
// before a real Tenant identity existed — resident self-service (a
// Resident logging in to see its own community) is the same kind of
// later phase Module 13's own history already went through.

model Community {
  id             String   @id @default(uuid())
  accountId      String
  name           String
  addressLine    String
  city           String?
  state          String?
  country        String
  communityType  String // estate | apartment_building | gated_community
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account       Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  residents     Resident[]
  announcements CommunityAnnouncement[]

  @@map("communities")
}

// Module 24's "Branch property report"/"Facility cost report" (Company
// Reports) — the structural gap a code-level audit found: a COMPANY
// account managing properties across multiple physical locations/offices
// had nowhere to record that grouping at all, so those two reports could
// never have existed no matter how the report code was written. Same
// shape as Community above (an account-owned, optionally-located
// sub-resource), deliberately not account-type-restricted at the schema
// level — a FAMILY or INDIVIDUAL account with properties in more than
// one city can use this too, same as nothing else in this schema gates
// on accountType beyond what a role's own permission set decides.
// Properties are optionally assigned (Property.branchId, nullable) — a
// property never has to belong to one, and every report below accounts
// for an "Unassigned" bucket rather than assuming full coverage.
model Branch {
  id        String   @id @default(uuid())
  accountId String
  name      String
  city      String?
  state     String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  properties Property[]

  @@map("branches")
}

// Freeform, same "record what's true, no forced workflow" reasoning
// Lease.tenantName/MaintenanceRequest.assignedTo already document — not
// every resident of an estate wants or needs their own platform login.
// No email/phone required for the same reason: some residents are only
// ever mentioned by the estate admin at all (e.g., a unit currently
// vacant but still tracked).
model Resident {
  id           String   @id @default(uuid())
  communityId  String
  name         String
  unitNumber   String
  email        String?
  phone        String?
  residentType String   @default("tenant") // owner | tenant
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@map("residents")
}

// The estate-level counterpart to PropertyAnnouncement — same "landlord
// communicating with the people it houses" shape, one level up: an
// estate manager broadcasting to every resident of one community, not a
// single lease's own tenant. Always scoped to exactly one community
// (unlike PropertyAnnouncement's nullable propertyId) — an account
// managing several communities at once posting to residents across all
// of them isn't a need this phase's own scope covers.
model CommunityAnnouncement {
  id              String   @id @default(uuid())
  communityId     String
  title           String
  body            String
  createdByUserId String
  createdAt       DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@map("community_announcements")
}

// --- Module 19: Communication and Notifications, Phase 1 ----------------
//
// Real, user-supplied scope. Of the blueprint's own channel list (Email,
// SMS, WhatsApp, Push, In-app, Voice), Email already had a real provider
// (EmailService/Resend, used for password reset/invites/report digests)
// — this pass builds the other channel achievable with no new paid
// infrastructure: In-app notifications. SMS/WhatsApp/push/voice would
// each need a real provider account/API key, the same kind of external
// dependency Paystack payouts and OpenAI embeddings are already blocked
// on elsewhere in this file — not attempted, not faked. `type` is a
// plain string, not an enum, matching every other "kind" field in this
// schema (Document.documentType, Dispute.disputeType, ...) — see
// NotificationsService for the fixed set Phase 1 actually creates. `link`
// is a relative app path the web client can navigate to directly, same
// "URL you provide yourself" shape as the rest of this schema's own
// *Url fields, just internal instead of external. readAt (not a boolean)
// records *when* a notification was read, not just whether — free
// information neither this pass nor a later one has to throw away.
model Notification {
  id        String    @id @default(uuid())
  accountId String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// The visibility-package catalog — real, admin-defined SKUs (seed.ts seeds
// a starting set), not a free-text plan name. Each row IS a specific
// purchasable tier+period pair (e.g. "Featured — Monthly", "Featured —
// Annual") rather than a tier with a period toggle, so pricing per period
// is just this row's own `price`, no separate rate table. `boostWeight`
// breaks ties when two currently-boosted accounts compete for the same
// slot (see PackagesService/boost.util.ts) — a higher tier's subscriber
// always outranks a lower tier's, regardless of who subscribed first.
model VisibilityPackage {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  description   String?
  price         Decimal  @db.Decimal(14, 2)
  currency      String
  billingPeriod String // monthly | annual
  boostWeight   Int      @default(1)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions PackageSubscription[]

  @@map("visibility_packages")
}

// One row per purchase, not a single "current subscription" column on
// Account — a full history, same reasoning Payout/Payment keep their own
// append-only rows rather than a single mutable balance. Deliberately no
// stored "expired" status: status only ever moves pending -> active (or
// -> failed) exactly once; whether an "active" row is *currently* boosting
// is always computed live as `status === 'active' && expiresAt > now`
// (see boost.util.ts) rather than a cron flipping a flag — nothing here
// depends on knowing the instant it lapses, only whether it has right now.
//
// Phase 2 (this pass) — real auto-renewal, Paystack only (the one gateway
// this scaffold already treats as "full-featured" elsewhere, e.g. its own
// bank list/resolve routes for payouts): authorizationCode is Paystack's
// own reusable-card token, captured off a *successful* verify when
// Paystack's own `authorization.reusable` flag says it can be charged
// again with no cardholder present (see PaystackService.verifyTransaction
// and PackagesService.chargeRenewal) — null for every manual/Flutterwave/
// PayPal/Stripe row, and for a Paystack row whose card turned out not to
// be reusable. payerEmail is the exact email Paystack associated with
// that authorization at charge time — required to charge it again,
// carried forward unchanged across a renewal chain rather than
// re-derived from account membership (which could resolve to a different
// email than the one Paystack actually knows this card by).
// renewedFromId is a soft reference (no FK — same convention
// ListingInquiry.accountId's own comment already uses) to the row a
// successful auto-renewal renewed from, for the "My packages" history
// screen to show a chain rather than unrelated purchases. autoRenew only
// ever stays true on the single most-recent row in a chain — a
// successful *or* failed renewal attempt both flip it off on the row
// being renewed (see PackagesSchedulerService's own comment for why a
// failed attempt doesn't retry).
model PackageSubscription {
  id                String    @id @default(uuid())
  accountId         String
  packageId         String
  status            String    @default("pending") // pending | active | failed
  amount            Decimal   @db.Decimal(14, 2)
  currency          String
  provider          String    @default("manual") // manual | paystack | flutterwave | stripe | paypal
  providerReference String?
  startedAt         DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  autoRenew         Boolean   @default(false)
  authorizationCode String?
  payerEmail        String?
  renewedFromId     String?

  account Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  package VisibilityPackage @relation(fields: [packageId], references: [id])

  @@index([accountId])
  @@index([autoRenew, status, expiresAt])
  @@map("package_subscriptions")
}
