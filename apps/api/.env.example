DATABASE_URL="postgresql://potg:potg@localhost:5432/potg?schema=public"
JWT_SECRET="dev-secret-change-me"
PORT=3001

# Optional — omit to use the stub LLM provider (see src/ai/llm).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Optional — omit to fall back to the "manual" simulated deposit path
# (see src/payments/paystack.service.ts). A test secret key from
# https://dashboard.paystack.com/#/settings/developer is enough; nothing
# here ever needs to be a live key for this scaffold.
PAYSTACK_SECRET_KEY=

# Optional — omit to leave every Flutterwave deposit/payout on the manual
# simulated path. A test secret key from
# https://dashboard.flutterwave.com/settings/apis is enough.
FLUTTERWAVE_SECRET_KEY=

# Optional (both, together) — omit either to leave PayPal on the manual
# simulated path. A sandbox app's Client ID/Secret from
# https://developer.paypal.com/dashboard/applications are enough.
# PAYPAL_MODE=live is an explicit opt-in only; sandbox is the default.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE="sandbox"

# Optional — omit to leave every Stripe deposit on the manual simulated
# path, same as any other unconfigured gateway (see
# src/payments/stripe.service.ts's own comment on why Stripe is
# deposit-only, not payout-capable, by design). A test secret key from
# https://dashboard.stripe.com/test/apikeys is enough — verified live
# with Stripe's own test card, real checkout through to a completed
# deposit and a credited escrow balance.
STRIPE_SECRET_KEY=

# Where a real gateway's checkout redirects the browser afterward, and —
# since a later pass — the exact origin main.ts's CORS config allows to
# send/receive the httpOnly auth cookies (see src/auth/cookie.util.ts).
# Not the API's own origin in either case; the web app's.
WEB_APP_URL="http://localhost:3000"

# Optional — omit to fall back to logging password-reset/invite links
# server-side and returning them in the API response instead (see
# src/notifications/email.service.ts). A free API key from
# https://resend.com/api-keys is enough. Without a verified sending
# domain, Resend's sandbox sender (the default EMAIL_FROM below) only
# actually delivers to the email address your Resend account itself is
# registered with — set EMAIL_FROM to an address on a domain you've
# verified with Resend to email arbitrary recipients.
RESEND_API_KEY=
EMAIL_FROM="PropertyOnTheGo <onboarding@resend.dev>"

# Optional (both, together) — omit either to leave every NIN verification
# attempt failing with a clear "not configured" error rather than
# silently succeeding (see src/identity/dojah.service.ts). A sandbox
# App ID + secret key from https://app.dojah.io (Settings > API Keys) are
# enough — nothing here ever needs to be a live key for this scaffold.
# DOJAH_ENV=production is an explicit opt-in only; sandbox is the default.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_ENV="sandbox"

# Optional — omit to leave POST /visualizations/property/:propertyId
# failing with a clear "not configured" error (see
# src/visualizations/openai-image.service.ts). A real API key from
# https://platform.openai.com/api-keys is required — OpenAI's Images API
# has no sandbox/test mode, so calls here cost real money per generation
# even while testing.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL="gpt-image-1"

# Optional (all five, together) — omit any to leave visualization
# requests failing at the storage step with a clear "not configured"
# error, even if OPENAI_API_KEY above is set (see
# src/visualizations/storage.service.ts). Needed because an AI image
# API's own returned URL typically expires in hours — this is where the
# generated "after" image actually ends up living. Create an R2 bucket
# and an API token (Account Home > R2 > Manage API tokens) at
# https://dash.cloudflare.com, and enable public access on the bucket
# (or map a custom domain to it) for R2_PUBLIC_BASE_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
