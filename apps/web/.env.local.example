# Copy to .env.local for local development.
# Base URL of the NestJS API (apps/api) — defaults to this value in lib/api.ts
# if the env var is unset, so this file is documentation more than requirement.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Powers the Live View card on each property page (Google Maps Embed API
# + Street View) — see pages/properties/[id].tsx's PropertyLiveViewCard.
# Must be a browser-exposed key (NEXT_PUBLIC_ reaches the client bundle),
# with Maps Embed API enabled. Can be the same value as the API's own
# GOOGLE_MAPS_API_KEY (apps/api/.env.example) if that key has no HTTP-
# referrer restriction, but Google's own guidance is a separate,
# referrer-restricted key for anything shipped to the browser. Omit to
# leave the card showing a plain "not configured" message.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
